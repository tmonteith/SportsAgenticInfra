flowchart TD
    subgraph DNS["DNS & Traffic Entry"]
        Registrar["Porkbun Registrar<br/>(Domain: sportsagentic.dev)"]
        OCIDNS["OCI Public Anycast DNS Zone<br/>(sportsagentic.dev)<br/>• Apex A: sportsagentic.dev<br/>• Wildcard A: *.sportsagentic.dev"]
    end

    subgraph OCI["Oracle Cloud Infrastructure (OCI) — Tenancy: sportsagentic-1"]
        direction TB

        subgraph VCN["Virtual Cloud Network (10.0.0.0/16)"]
            direction TB
            subgraph Gateways["VCN Gateways"]
                IGW["Internet Gateway<br/>(0.0.0.0/0 Public Ingress/Egress)"]
                NAT["NAT Gateway<br/>(0.0.0.0/0 Private Outbound)"]
                SGW["Service Gateway<br/>(Oracle Services Network - OSN)"]
            end

            subgraph PublicSubnetLB["Public Load Balancer Subnet (10.0.1.0/24)"]
                FlexLB["OCI Flexible Load Balancer<br/>Shape: 10 Mbps min / 10 Mbps max (Always Free)<br/>Reserved Public IP | Ports 80, 443"]
