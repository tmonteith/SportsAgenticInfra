                        ModelPVC[("PVC: model-cache<br/>10Gi GGUF Weight Volume")]
                    end
                end
            end
        end

        subgraph PlatformServices["OCI Platform Services (OSN via Service Gateway)"]
            NoSQL[("OCI NoSQL Database<br/>Table: sportsagentic_cfb<br/>Millisecond Timestamps TIMESTAMP(3)<br/>Provisioned Read/Write Units")]
