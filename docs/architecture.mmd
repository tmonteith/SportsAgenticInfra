            subgraph PublicSubnetAPI["Public K8s API Subnet (10.0.0.0/28)"]
                OKEAPI["OKE Kubernetes API Server<br/>Port 6443 (Authorized CIDRs)"]
            end

            subgraph PrivateSubnetNodes["Private Worker Nodes Subnet (10.0.10.0/24)"]
                subgraph OKECluster["Oracle Container Engine for Kubernetes (OKE v1.34+)"]
