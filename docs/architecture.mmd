            CIUser["CI Service Account: sportsagentic-app-ci"]
        end
    end

    subgraph ExternalServices["External Cloud & Data APIs"]
        CFBD["College Football Data (CFBD) API<br/>https://api.collegefootballdata.com"]
        Gemini["Google Gemini Cloud API<br/>(Orchestrator Backup Failover)"]
    end

    Registrar -->|NS Delegation| OCIDNS
    OCIDNS -->|A Record Resolution| FlexLB
