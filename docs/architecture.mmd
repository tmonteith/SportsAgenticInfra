                    subgraph NodePool["Consolidated Worker Node Pool ('model-pool')"]
                        Node1["ARM Ampere A1 (VM.Standard.A1.Flex)<br/>4 OCPUs / 24 GB RAM (or E5 x86)<br/>Untainted: Platform + Workloads Co-exist"]
                    end

                    subgraph NS_Ingress["Namespace: ingress-nginx"]
