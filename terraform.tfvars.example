# Root stack configuration example
tenancy_ocid         = "ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
region               = "us-ashburn-1"
compartment_id       = "ocid1.compartment.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
compartment_name     = "sportsagentic"
identity_domain_name = "Default"
prefix               = "sportsagentic"
cluster_type         = "BASIC_CLUSTER"
k8s_version          = "v1.34.10"
node_shape           = "VM.Standard.A1.Flex" # Or "VM.Standard.E5.Flex" / "VM.Standard.E4.Flex" if region is out of Ampere ARM capacity
domain_name          = "sportagentic.dev"

# Optional: override node image OCID if dynamic discovery is not desired
# node_image_id      = ""

# Optional: target specific fault domains if one is out of host capacity
# node_fault_domains = ["FAULT-DOMAIN-1", "FAULT-DOMAIN-2", "FAULT-DOMAIN-3"]

# Single node pool configuration (Always Free: 1 node, 4 OCPUs, 24 GB RAM)
model_pool_size          = 1
model_pool_ocpus         = 4
model_pool_memory_in_gbs = 24

letsencrypt_email = "admin@sportagentic.dev"
email             = "admin@sportagentic.dev"
